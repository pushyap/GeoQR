# GeoQR Backend Environment Variables

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# JWT Secret (use a strong random string)
JWT_SECRET=your-super-secret-jwt-key-here

# Device Authentication (optional, defaults to JWT_SECRET)
DEVICE_JWT_SECRET=your-device-jwt-secret-here

# QR Code Signing (optional, defaults to JWT_SECRET)
QR_SIGNING_SECRET=your-qr-signing-secret-here

# QR Token Expiry (seconds)
QR_TOKEN_EXPIRY_SECONDS=10

# Redis (optional - falls back to in-memory if not configured)
REDIS_URL=redis://localhost:6379

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30

# Email Configuration (Gmail with App Password)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Server
PORT=3000
NODE_ENV=development
