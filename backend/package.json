{
    "name": "geoqr-backend",
    "version": "1.0.0",
    "description": "GeoQR Attendance System Backend API",
    "main": "server.js",
    "scripts": {
        "start": "node server.js",
        "dev": "node --watch server.js",
        "seed": "node scripts/seed.js",
        "test": "cross-env NODE_ENV=test jest --runInBand",
        "migrate:run": "node scripts/migrations/run_migrations.js",
        "migrate:check-unique": "node scripts/ensure_unique_webauthn_user.js"
    },
    "keywords": [
        "attendance",
        "qr",
        "gps",
        "nodejs"
    ],
    "author": "GeoQR Team",
    "license": "MIT",
    "dependencies": {
        "@neondatabase/serverless": "^0.9.0",
        "@simplewebauthn/server": "^13.2.2",
        "bcryptjs": "^2.4.3",
        "cors": "^2.8.5",
        "dotenv": "^16.3.1",
        "express": "^4.18.2",
        "express-rate-limit": "^8.2.1",
        "express-validator": "^7.0.1",
        "form-data": "^4.0.5",
        "jsonwebtoken": "^9.0.2",
        "mailgun.js": "^12.6.0",
        "nodemailer": "^7.0.12",
        "pdfkit": "^0.17.2",
        "pdfkit-table": "^0.1.99",
        "pg": "^8.16.3",
        "redis": "^5.10.0",
        "resend": "^6.8.0",
        "sqlite3": "^5.1.7",
        "uuid": "^9.0.0"
    }
    ,
    "devDependencies": {
        "cross-env": "^7.0.3",
        "jest": "^29.7.0",
        "supertest": "^6.3.3"
    }
